#!/bin/bash
#PBS -N QUASAR_v15_s456
#PBS -q A100
#PBS -l select=1:ncpus=32:mem=64gb
#PBS -l walltime=72:00:00
#PBS -j oe
#PBS -o /home/ralshehri0468/quasar_v15/logs/v15_s456.log

WORKDIR="/home/ralshehri0468/quasar_v15"
LOGFILE="$WORKDIR/logs/v15_s456_tee.log"
mkdir -p "$WORKDIR/logs" "$WORKDIR/results"

exec > >(tee -a "$LOGFILE") 2>&1

echo "=== QUASAR v15 + SiliQun | Seed 456 | All Families 2Q-12Q ==="
echo "Start: $(date)"
echo "Node: $(hostname)"
nvidia-smi | head -15 || echo "No nvidia-smi"

source /opt/share/anaconda3/2024.06/etc/profile.d/conda.sh 2>/dev/null || \
source /opt/share/anaconda3/2023.09/etc/profile.d/conda.sh 2>/dev/null || \
source ~/miniconda3/etc/profile.d/conda.sh 2>/dev/null || \
{ echo "FATAL: Cannot find conda"; exit 1; }

conda activate quantum_drl_gpu || conda activate mqcf || \
{ echo "FATAL: Cannot activate conda env"; exit 1; }

echo "Python: $(which python3) | $(python3 --version)"

python3 -c "from siliqun.engine.gym_env import make_siliqun_env; print('SiliQun OK')" 2>/dev/null || {
    echo "Installing SiliQun..."
    pip install -e ~/siliqun --quiet
    python3 -c "from siliqun.engine.gym_env import make_siliqun_env; print('SiliQun installed OK')"
}

cd "$WORKDIR"
python3 quasar_v15.py \
    --seed 456 \
    --qubit_min 2 \
    --qubit_max 12 \
    --targets GHZ W Cluster Dicke-k3 \
    --results_dir "$WORKDIR/results" \
    --max_steps 500000 \
    --dehb_outer_brackets 36 \
    --dehb_inner_brackets 8 \
    --log_every 5000

echo "=== DONE: $(date) ==="
